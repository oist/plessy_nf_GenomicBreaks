nextflow_process {

    name "Test Process GENOMICBREAKS_STATS"
    script "../main.nf"
    process "GENOMICBREAKS_STATS"

    tag "modules"
    tag "modules_local"
    tag "genomicbreaks"

    // The skeleton reads the .o2o.tsv, .train and .o2o.matrix.txt files that
    // sit next to the real path of the alignment file; test_data/ has them.
    test("sarscov2 - blasttabplus") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/test_data/target___test2.blasttabplus.gz", checkIfExists: true),
                ]
                input[1] = file("${projectDir}/skeleton.Rmd", checkIfExists: true)
                """
            }
        }

        then {
            // Outside assertAll, so that a failed run does not write a snapshot.
            assert process.success
            assertAll(
                { assert snapshot(
                    // The YAML holds the statistics; the HTML report embeds
                    // run-specific content, so only its name is checked.
                    process.out.yaml,
                    process.out.html.collect { file(it).name },
                    process.out.versions_genomicbreaks
                ).match() }
            )
        }

    }

    test("sarscov2 - blasttabplus - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/test_data/target___test2.blasttabplus.gz", checkIfExists: true),
                ]
                input[1] = file("${projectDir}/skeleton.Rmd", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
