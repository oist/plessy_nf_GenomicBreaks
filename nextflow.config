manifest {
    author = 'Charles Plessy'
    description = 'Pairwise genome alignment analysis'
    name = 'pairwiseGenomeAlignStats'
    homePage = ''
    nextflowVersion = '>=21.04.0'
    version = '0.24.0'   // GenomicBreaks version plus 1 for every change of the skeleton.
}

params {
// nf-core parameters
    enable_conda                      = false
    outdir                            = './results'
    publish_dir_mode                  = 'copy'
    singularity_pull_docker_container = false

// Mandatory parameters
    input                             = false

// Optional parameters
    skel                              = 'https://raw.githubusercontent.com/oist/plessy_nf_GenomicBreaks/main/skeleton.Rmd'
    trace_report_suffix               = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

// Load nf-core custom profiles from different Institutions
    custom_config_version             = 'master'
    custom_config_base                = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
}

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load nf-core/pairgenomealign custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

process {
  withLabel:process_low {
    cpus = 2
    memory = 14.GB
    time =  6.h
  }
  withLabel:process_medium {
    cpus = 6
    memory = 42.GB
    time = 8.h
  }
  withLabel:process_high {
    cpus = 24
    memory = 84.GB
    time = 10.h
  }
  withLabel:process_long {
    time = 20.h
  }
  withName:GENOMICBREAKS_STATS {
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
    maxRetries = 2
  }
  publishDir = [
    path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
    mode: params.publish_dir_mode,
  ]
}

// Execution reports, named and placed as in nf-core pipelines: one set per run,
// suffixed with the launch time (or --trace_report_suffix), in pipeline_info/.
// The HTML report keeps at most report.maxTasks tasks (Nextflow default 10,000);
// the trace keeps all of them.  The first 14 trace fields are Nextflow's
// defaults, in their default order; the others record the requested resources,
// the attempt, the I/O and the CPU model, which the local executor gives no other
// way to recover (there is no per-task sacct record).
timeline {
  enabled = true
  file = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}

report {
  enabled = true
  file = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}

trace {
  enabled = true
  file = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
  fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,' +
           'process,tag,attempt,cpus,memory,time,start,complete,%mem,rss,vmem,read_bytes,write_bytes,syscr,syscw,' +
           'vol_ctxt,inv_ctxt,error_action,cpu_model'
}

dag {
  enabled = true
  file = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

executor {
    submitRateLimit = '2 sec'
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/pairgenomealign -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

profiles {
    test {
        process {
            resourceLimits = [
                cpus: 4,
                memory: '15.GB',
                time: '1.h'
            ]
        }
        params {
            config_profile_name        = 'Test profile'
            config_profile_description = 'Minimal test dataset to check pipeline function'
            input  = "test_data/input.tsv"
            skel   = "skeleton.Rmd"
        }
    }
}
