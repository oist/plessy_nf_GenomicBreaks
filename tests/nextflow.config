/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// The test data is a SARS-CoV-2 alignment of a few kilobases: cap the requests
// of the process labels so that the tests also run on a laptop or a small runner.
process {
    resourceLimits = [
        cpus: 2,
        memory: '4.GB',
        time: '1.h'
    ]
    // The pipeline ignores a pair that still fails after two retries; in the
    // tests, a failure must fail the run.
    withName: GENOMICBREAKS_STATS {
        errorStrategy = 'terminate'
    }
}
